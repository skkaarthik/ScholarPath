# ScholarPath assistant - copy this file to .env and fill in your key.
# .env is git-ignored. The key stays on the server: the browser never sees it.
# Without a key the assistant still works in "demonstration mode" (answers built
# directly from ScholarPath's records, clearly labelled, no AI).
#
# 1. Create a free Groq account (no card needed): https://console.groq.com
# 2. Open API Keys -> Create API Key, copy it (it is shown only once).
# 3. Paste it below, save the file as .env in the project folder, restart the app.
# 4. Check it:  python -m scholarpath ai-check
#
# Hosted on Streamlit Community Cloud? Put the same lines (TOML: NAME = "value")
# into the app's Settings -> Secrets instead of a .env file.

SCHOLARPATH_AI_API_KEY=your-api-key-here

# Optional. Defaults shown. Any OpenAI-compatible chat API works.
# Gemini instead of Groq: SCHOLARPATH_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                         and a Gemini model name from https://aistudio.google.com
SCHOLARPATH_AI_BASE_URL=https://api.groq.com/openai/v1
SCHOLARPATH_AI_MODEL=openai/gpt-oss-120b

# Optional. Server-wide limits shared by all visitors (keep them under the provider's free quota).
SCHOLARPATH_AI_MAX_PER_MINUTE=6
SCHOLARPATH_AI_MAX_PER_DAY=900
